# ==============================================================================
# COMPLAINT-EC ENVIRONMENT TEMPLATE (.env.example)
# Sao chép file này thành .env và điền các thông tin bảo mật phù hợp
# ==============================================================================

# 1. Service API Authentication (BUG-1113: Xác thực quyền sử dụng API cổng 8077)
# Đặt API key bí mật để xác thực các request gửi đến service qua header X-API-Key
SERVICE_API_KEY=<CHANGE_TO_YOUR_STRONG_SERVICE_API_KEY>

# 2. LLM Gateway Configuration
LLM_GATEWAY_URL=http://<LLM_GATEWAY_HOST>:<PORT>/v1
LLM_GATEWAY_API_KEY=<CHANGE_TO_YOUR_LLM_GATEWAY_API_KEY>
LLM_MODEL_NAME=google/gemma-4-26B-A4B-it

# 3. OCR Microservice
OCR_SERVICE_URL=https://<OCR_SERVICE_HOST>

# 4. Message Queue (RabbitMQ Broker cho Celery)
CELERY_BROKER_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@<RABBITMQ_HOST>:<PORT>/<VHOST>

# 5. Result Backend (Redis cho Celery)
CELERY_RESULT_BACKEND=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:<PORT>/0

# 6. Object Storage (MinIO)
MINIO_ENDPOINT=<MINIO_HOST>:<PORT>
MINIO_ROOT_USER=<CHANGE_TO_YOUR_MINIO_USER>
MINIO_ROOT_PASSWORD=<CHANGE_TO_YOUR_MINIO_PASSWORD>
MINIO_BUCKET_NAME=x2-dannguyen-uc1-logs
MINIO_CACHE_BUCKET=x2-dannguyen-uc1-cache
MINIO_KB_BUCKET=x2-dannguyen-uc1-config
MINIO_KB_OBJECT=knowledge_base.json
MINIO_SPELLING_BUCKET=x2-dannguyen-uc1-config
MINIO_SPELLING_OBJECT=spelling_error.json
MINIO_SECURE=false

# 7. Worker Concurrency
NUM_WORKERS=8

# 8. (Tùy chọn) Cấu hình xác thực cho cụm hạ tầng chạy Docker Compose (Profile 'infra')
# Chỉ định thông tin user/pass khi tự khởi chạy RabbitMQ và MinIO cục bộ
RABBITMQ_USER=<RABBITMQ_LOCAL_USER>
RABBITMQ_PASS=<RABBITMQ_LOCAL_PASSWORD>
# COMPOSE_PROFILES=infra
