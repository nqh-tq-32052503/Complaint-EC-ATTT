# ==============================================================================
# COMPLAINT-EC ENVIRONMENT TEMPLATE (.env.example)
# Sao chép file này thành .env và điều chỉnh các giá trị phù hợp
# ==============================================================================

# 1. LLM Gateway Configuration
# Khi chạy trong Docker Compose: dùng http://host.docker.internal:4000/v1 nếu LLM chạy trên host
# Hoặc URL service LLM nếu chạy trên cụm khác (VD: http://10.0.11.184:4000/v1)
LLM_GATEWAY_URL=http://host.docker.internal:4000/v1
LLM_GATEWAY_API_KEY=your_llm_gateway_api_key
LLM_MODEL_NAME=google/gemma-4-26B-A4B-it

# 2. OCR Microservice
OCR_SERVICE_URL=https://8085--main--dev--sinhnq3.coder.vts-ai.space

# 3. Message Queue (RabbitMQ Broker cho Celery)
CELERY_BROKER_URL=amqp://username:password@10.0.11.184:5673//shared

# 4. Result Backend (Redis cho Celery)
CELERY_RESULT_BACKEND=redis://username:password@10.0.11.184:6380/0

# 5. Database (PostgreSQL)
POSTGRES_HOST=10.0.11.184
POSTGRES_PORT=5436
POSTGRES_DB=shared_projects
POSTGRES_USER=platform_developer
POSTGRES_PASSWORD=your_postgres_password

# 6. Object Storage (MinIO)
MINIO_ENDPOINT=10.0.11.184:9010
MINIO_ROOT_USER=platform_developer
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_BUCKET_NAME=x2-dannguyen-uc1-logs
MINIO_CACHE_BUCKET=x2-dannguyen-uc1-cache
MINIO_KB_BUCKET=x2-dannguyen-uc1-config
MINIO_KB_OBJECT=knowledge_base.json
MINIO_SPELLING_BUCKET=x2-dannguyen-uc1-config
MINIO_SPELLING_OBJECT=spelling_error.json
MINIO_SECURE=false

# 7. Worker Concurrency
NUM_WORKERS=8

# 8. (Tùy chọn) Bật profile 'infra' nếu muốn Docker Compose tự dựng RabbitMQ, Redis, MinIO, Postgres cục bộ
# COMPOSE_PROFILES=infra
